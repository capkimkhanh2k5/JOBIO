# Docker Compose shared environment variables
# Copy to .env and replace with your real secrets before running compose.

POSTGRES_DB=jobportal_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
# Destructive: set to 1 only for a one-time production DB volume rebuild.
POSTGRES_RESET_VOLUME_ON_AUTH_FAILURE=0

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

PGADMIN_DEFAULT_EMAIL=admin@jobio.local
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
PGADMIN_CONFIG_SERVER_MODE=True
