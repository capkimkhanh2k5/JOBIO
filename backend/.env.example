# DATABASE CONFIG
DB_NAME=jobportal_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=postgres
DB_PORT=5432

# DJANGO CONFIG
DEBUG=1
SECRET_KEY=django-insecure-change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:4000,http://localhost:5173

# OPENAI CONFIG (for AI Matching semantic analysis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
