# DATABASE CONFIG
DB_NAME=jobportal_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=postgres
DB_PORT=5432

# DJANGO CONFIG
DEBUG=1
SECRET_KEY=django-insecure-change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:4000,http://localhost:5173

# CLOUDINARY CONFIG (used for direct CV upload + parser download)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OPENAI CONFIG (for AI Matching semantic analysis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GROQ CONFIG (for CV Parsing with LLM)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional failover/round-robin keys. Use only keys/accounts you are allowed to operate.
GROQ_API_KEYS=gsk_optional_key_2,gsk_optional_key_3,gsk_optional_key_4,gsk_optional_key_5
GROQ_CV_PARSER_MODEL=openai/gpt-oss-120b
GROQ_CV_PARSER_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_CV_MODERATION_ENABLED=1
GROQ_CV_MODERATION_MODEL=openai/gpt-oss-safeguard-20b
GROQ_CV_MODERATION_MAX_OUTPUT_TOKENS=256
GROQ_CV_PARSER_MAX_INPUT_CHARS=8000
GROQ_CV_PARSER_MAX_OUTPUT_TOKENS=2048
CV_UPLOAD_MAX_BYTES=10485760
CV_PDF_MAX_PAGES=3
CV_PARSE_ALLOWED_HOSTS=res.cloudinary.com
