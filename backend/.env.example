# DATABASE CONFIG
DB_NAME=jobportal_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=postgres
DB_PORT=5432

# DJANGO CONFIG
DEBUG=1
SECRET_KEY=django-insecure-change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:4000,http://localhost:5173
HEALTHCHECK_TOKEN=change-me-for-production-deep-health

# CLOUDINARY CONFIG (used for direct CV upload + parser download)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# REDIS / CELERY CONFIG
# REDIS_URL is the default for Celery broker/result backend when specific URLs are not set.
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_RESULT_EXPIRES=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_QUEUES=default,emails,cleanup,matching,media,ai
CELERY_TASK_ACKS_LATE=1
CELERY_TASK_SOFT_TIME_LIMIT=90
CELERY_TASK_TIME_LIMIT=120
CELERY_BROKER_VISIBILITY_TIMEOUT=3600
REDIS_IGNORE_EXCEPTIONS=0

# EMBEDDING / VECTOR CONFIG (for semantic job recommendations)
OPENAI_API_KEY=your_openai_api_key_here
RECOMMENDATION_SEMANTIC_ENABLED=1
RECOMMENDATION_EMBEDDING_PROVIDER=local
RECOMMENDATION_EMBEDDING_MODEL=BAAI/bge-m3
RECOMMENDATION_EMBEDDING_DIMENSIONS=1024
RECOMMENDATION_SYNC_EMBEDDINGS=0
RECOMMENDATION_VECTOR_STORE=pgvector
RECOMMENDATION_VECTOR_VERSION=v2
RECOMMENDATION_PGVECTOR_EF_SEARCH=80
RECOMMENDATION_REQUIRE_SAFETENSORS=1
MODERATION_ENABLED=1
# Use "rule" for local/dev, "openai" for OpenAI text/image moderation provider.
MODERATION_PROVIDER=rule
MODERATION_TEXT_MODEL=omni-moderation-latest
MODERATION_IMAGE_MODEL=omni-moderation-latest
JOB_DOMAIN_MIN_CONFIDENCE=0.85

# GROQ CONFIG (for CV Parsing with LLM)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional failover/round-robin keys. Use only keys/accounts you are allowed to operate.
GROQ_API_KEYS=gsk_optional_key_2,gsk_optional_key_3,gsk_optional_key_4,gsk_optional_key_5
GROQ_CV_PARSER_MODEL=openai/gpt-oss-120b
GROQ_CV_PARSER_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_CV_MODERATION_ENABLED=1
GROQ_CV_MODERATION_MODEL=openai/gpt-oss-safeguard-20b
GROQ_CV_MODERATION_MAX_OUTPUT_TOKENS=256
GROQ_CV_PARSER_MAX_INPUT_CHARS=8000
GROQ_CV_PARSER_MAX_OUTPUT_TOKENS=2048
CV_UPLOAD_MAX_BYTES=10485760
CV_PDF_MAX_PAGES=3
CV_PARSE_ALLOWED_HOSTS=res.cloudinary.com
